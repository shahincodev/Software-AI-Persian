# .env.example
# Environment Variables for Software-AI
# متغیرهای محیطی برای Software-AI
# ================================================================================
# توجه: این فایل نمونه است. برای استفاده:
# Copy-Item .env.example .env
# سپس فایل .env را تحریر کنید و کلیدهای واقعی را جایگزین کنید.

# ================================================================================
# API Keys - کلیدهای API
# ================================================================================

# OpenRouter - دسترسی به هزاران مدل رایگان و پولی
# Provider: OpenRouter (OpenAI-compatible endpoint)
# مدل‌های رایگان: meta-llama/llama-3.3-70b-instruct:free, qwen/qwen3-235b-a22b:free
# دریافت کلید: https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-key-here

# Google AI Studio - مدل‌های رایگان Gemini
# Provider: Google (Gemini 2.5 Flash)
# رایگان (سهمیه: 10 درخواست در دقیقه، 250 درخواست در روز)
# دریافت کلید: https://aistudio.google.com/app/apikeys
GOOGLE_API_KEY=your-google-api-key-here

# Groq - مدل‌های سریع و رایگان
# Provider: Groq (Llama 3.3 70B, Qwen3 32B)
# رایگان (30 درخواست در دقیقه)
# دریافت کلید: https://console.groq.com
GROQ_API_KEY=your-groq-key-here

# HuggingFace Inference API - دسترسی به مدل‌های متنوع
# رایگان (سهمیه: 30 درخواست در سه ساعت)
# دریافت کلید: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-token-here

# Anthropic Claude (اختیاری - از طریق OpenRouter قابل دسترسی)
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI Direct API (اختیاری - اگر از OpenRouter استفاده می‌کنید نیاز نیست)
OPENAI_API_KEY=your-openai-key-here

# GapGPT - سرورهای اختصاصی با مدل‌های رایگان و باکیفیت
# Provider: GapGPT (gapgpt-qwen-3.6)
# رایگان - سرورهای اختصاصی
# دریافت کلید: https://gapgpt.com
GAPGPT_API_KEY=your-gapgpt-key-here

# ================================================================================
# مدل‌های هوشمند - Smart Models
# ================================================================================

# دمای مدل‌ها (0.0 = منطقی/دقیق، 1.0 = خلاق/متنوع)
MODEL_TEMPERATURE=0.5

# دمای خاص برای عملیات سیستمی (کمتر = دقیق‌تر و قابل‌پیش‌بینی)
SYSTEM_MODEL_TEMPERATURE=0.3

# ================================================================================
# Ollama - مدل‌های محلی (اختیاری)
# دریافت Ollama: https://ollama.ai
# نصب مدل: ollama pull neural-chat
# ================================================================================
OLLAMA_BASE_URL=http://localhost:11434

# ================================================================================
# ابزارهای جانبی - Auxiliary Tools
# ================================================================================

# مسیر Tesseract برای OCR (اختیاری)
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# کلید Browser Use (اختیاری)
BROWSER_USE_API_KEY=your-browser-use-key-here

# مسیر فایل اعتبارنامه Google Cloud برای Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google-cloud-credentials.json

# کلید جلسه اختیاری که توسط عامل‌ها استفاده می‌شود
SESSION_KEY=your-session-key-here

# کلید API برای ElevenLabs (برای TTS با کیفیت بالا)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ================================================================================
# تنظیمات سیستم - System Settings
# ================================================================================

# حالت دیباگ (true/false)
DEBUG=false

# سطح لاگ (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# پیکربندی مرورگر: 1=true (headless), 0=false (با سر)
BROWSER_HEADLESS=1

# غیرفعال کردن بنر راه‌اندازی (0=فعال, 1=غیرفعال)
DISABLE_BANNER=0

# ================================================================================
# Smart API Checker - بررسی‌کننده هوشمند API
# ================================================================================

# فعال‌سازی بررسی خودکار API در هنگام راه‌اندازی
AUTO_CHECK_API=true

# نمایش جدول وضعیت ارائه‌دهندگان
SHOW_PROVIDER_STATUS=true

# ================================================================================
# Notes / توضیحات تکمیلی:
# ================================================================================
# - اگر روی ویندوز اجرا می‌کنید و می‌خواهید از رنگ‌های ANSI استفاده کنید،
#   کتابخانه‌هایی مثل colorama نیاز به init دارند.
# - برای نگهداری ایمن کلیدها در سرویس‌های CI/CD، از Secrets/Variables مخزن خود
#   استفاده کنید (مثلاً GitHub Actions secrets) و فایل .env را در مخزن قرار ندهید.
# - از ابزار `python tools/api_checker.py` برای بررسی وضعیت APIها استفاده کنید.