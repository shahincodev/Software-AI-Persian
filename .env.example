# .env.example
# Environment Variables for Software-AI
# متغیرهای محیطی برای Software-AI
# ================================================================================
# توجه: این فایل نمونه است. برای استفاده:
# Copy-Item .env.example .env
# سپس فایل .env را تحریر کنید و کلیدهای واقعی را جایگزین کنید.

# ================================================================================
# OpenRouter - دسترسی به هزاران مدل (OpenAI, Claude, Mistral و بیشتر)
# Provider: OpenRouter (OpenAI-compatible endpoint)
# رایگان با پرداخت از طریق استفاده
# دریافت کلید: https://openrouter.ai
# ================================================================================
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here-replace-with-real-key

# ================================================================================
# Google AI Studio - مدل‌های رایگان Gemini
# Provider: Google (Gemini 3 Pro Preview, Gemini 2.5 Flash/Pro)
# رایگان (سهمیه: 20 درخواست در روز برای رایگان)
# دریافت کلید: https://aistudio.google.com/app/apikeys
# ================================================================================
GOOGLE_API_KEY=AIza-your-google-api-key-here-replace-with-real-key

# ================================================================================
# Groq - مدل‌های سریع و رایگان
# Provider: Groq (Mixtral 8x7B, Llama 3.1 70B)
# رایگان
# دریافت کلید: https://console.groq.com
# ================================================================================
GROQ_API_KEY=gsk-your-groq-key-here-replace-with-real-key

# ================================================================================
# HuggingFace Inference API - دسترسی به مدل‌های متنوع
# رایگان (سهمیه: 30 درخواست در سه ساعت)
# دریافت کلید: https://huggingface.co/settings/tokens
# ================================================================================
HUGGINGFACE_API_KEY=hf_your-huggingface-token-here-replace-with-real-key

# ================================================================================
# Anthropic Claude (اختیاری - برای OpenRouter ضروری نیست)
# ================================================================================
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ================================================================================
# تنظیمات مدل‌های هوشمند
# ================================================================================
# دمای مدل‌ها (0.0 = منطقی/دقیق، 1.0 = خلاق/متنوع)
MODEL_TEMPERATURE=0.5

# دمای خاص برای عملیات سیستمی (کمتر = دقیق‌تر و قابل‌پیش‌بینی)
SYSTEM_MODEL_TEMPERATURE=0.3

# ================================================================================
# Ollama - مدل‌های محلی (اختیاری)
# دریافت Ollama: https://ollama.ai
# نصب مدل: ollama pull neural-chat
# ================================================================================
OLLAMA_BASE_URL=http://localhost:11434

# ================================================================================
# OpenAI Direct API (اختیاری - استفاده نکنید اگر از OpenRouter استفاده می‌کنید)
# ================================================================================
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ================================================================================
# تنظیمات سیستم
# ================================================================================
DEBUG=false
LOG_LEVEL=INFO

# مسیر Tesseract برای OCR (اختیاری)
TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# کلید Browser Use (اختیاری)
BROWSER_USE_API_KEY=bu_your-browser-use-key-here

# کلید API GROQ (Groq)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# کلید API OpenAI (یا کلید ارائه‌دهنده‌ی شما)
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# کلید API Google (در صورت استفاده برای مدل‌ها یا نقشه‌ها و غیره)
GOOGLE_API_KEY=AIzaY0UR_GOOGLE_API_KEY_HERE

# مسیر فایل اعتبارنامه Google Cloud برای Text-to-Speech
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google-cloud-credentials.json

# کلید جلسه اختیاری که توسط عامل‌ها استفاده می‌شود (اگر برنامه شما از آن استفاده می‌کند)
SESSION_KEY=your_session_key_here

# کلید API برای ElevenLabs (برای TTS با کیفیت بالا)
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# پیکربندی مرورگر: برای حالت بدون سر (headless) به 1 یا true و برای حالت با سر به 0/false تنظیم کنید
BROWSER_HEADLESS=1

# مقدار دماي مدل پيش‌فرض (به عنوان رشته اعشاری)
MODEL_TEMPERATURE=0.5

# پرچم‌های مفید دیگر
# اگر می‌خواهید بنر راه‌اندازی را در CLI غیرفعال کنید، می‌توانید تنظیم کنید:
DISABLE_BANNER=0

# NOTES / توضیحات تکمیلی:
# - اگر روی ویندوز اجرا می‌کنید و می‌خواهید از رنگ‌های ANSI استفاده کنید،
#   کتابخانه‌هایی مثل colorama نیاز به init دارند. این مربوط به کد برنامه است، نه .env.
# - برای نگهداری ایمن کلیدها در سرویس‌های CI/CD، از Secrets/Variables مخزن خود
#   استفاده کنید (مثلاً GitHub Actions secrets) و فایل .env را در مخزن قرار ندهید.
#
# اگر سرویس‌ها یا کلیدهای دیگری اضافه کردید، آن‌ها را به همین صورت در این فایل اضافه کنید.
